    {
      "parameters": {
        "jsCode": "\nconst content = $json.message?.content;\n\nif (!content) {\n  throw new Error(\"Ollama response is missing message.content\");\n}\n\nlet invoice;\n\ntry {\n  invoice = JSON.parse(content);\n} catch (error) {\n  throw new Error(\"Ollama returned invalid JSON: \" + error.message);\n}\n\nfunction toNumber(value) {\n  if (value === null || value === undefined || value === \"\") {\n    return null;\n  }\n\n  const number = Number(value);\n  return Number.isFinite(number) ? number : null;\n}\n\nfunction normalizeDate(value) {\n  if (value === null || value === undefined || value === \"\") {\n    return null;\n  }\n\n  const s = String(value).trim();\n  let year, month, day;\n  let match = s.match(/^(\\d{4})-(\\d{2})-(\\d{2})$/);\n\n  if (match) {\n    [, year, month, day] = match;\n  } else {\n    match = s.match(/^(\\d{2})\\/(\\d{2})\\/(\\d{4})$/);\n\n    if (!match) return null;\n\n    [, day, month, year] = match;\n  }\n\n  const iso = `${year}-${month}-${day}`;\n  const date = new Date(`${iso}T00:00:00Z`);\n\n  if (\n    Number.isNaN(date.getTime()) ||\n    date.toISOString().slice(0, 10) !== iso\n  ) {\n    return null;\n  }\n\n  return iso;\n}\n\nconst categories = [\n  \"Food\",\n  \"Travel\",\n  \"Office Supplies\",\n  \"Software & Subscriptions\",\n  \"Utilities\",\n  \"Equipment\",\n  \"Marketing\",\n  \"Rent\",\n  \"Professional Services\",\n  \"Miscellaneous\",\n  \"Unknown\"\n];\n\nconst paymentStatuses = [\n  \"paid\",\n  \"partially_paid\",\n  \"unpaid\",\n  \"unknown\"\n];\n\nconst issues = [];\n\nconst invoiceDate = normalizeDate(invoice.invoice_date);\nconst dueDate = normalizeDate(invoice.due_date);\n\nif (invoice.invoice_date && !invoiceDate) {\n  issues.push(\"Invoice date is missing, invalid, or ambiguous.\");\n}\n\nif (invoice.due_date && !dueDate) {\n  issues.push(\"Due date is missing, invalid, or ambiguous.\");\n}\n\nconst taxable = toNumber(invoice.taxable_amount);\nconst gst = toNumber(invoice.gst_amount);\nconst total = toNumber(invoice.total_invoice_amount);\nconst amountPaid = toNumber(invoice.amount_paid);\nconst outstanding = toNumber(invoice.outstanding_amount);\n\nconst gstin =\n  invoice.gstin == null ? null : String(invoice.gstin).trim();\n\nif (\n  gstin &&\n  !/^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$/.test(gstin)\n) {\n  issues.push(\"GSTIN format is invalid or incomplete; verify against the document.\");\n}\n\nlet category = String(invoice.invoice_type ?? \"Unknown\").trim();\n\nif (!categories.includes(category)) {\n  category = \"Unknown\";\n  issues.push(\"Expense category was not in the approved category list.\");\n}\n\nlet paymentStatus = String(\n  invoice.payment_status ?? \"unknown\"\n).trim().toLowerCase();\n\nif (!paymentStatuses.includes(paymentStatus)) {\n  paymentStatus = \"unknown\";\n  issues.push(\"Payment status was not recognized.\");\n}\n\nif (\n  taxable !== null &&\n  gst !== null &&\n  total !== null &&\n  Math.abs(taxable + gst - total) > 0.02\n) {\n  issues.push(\n    `Amount discrepancy: taxable amount plus GST is ${(taxable + gst).toFixed(2)}, but the invoice total is ${total.toFixed(2)}.`\n  );\n}\n\nif (\n  amountPaid !== null &&\n  outstanding !== null &&\n  total !== null &&\n  Math.abs(amountPaid + outstanding - total) > 0.02\n) {\n  issues.push(\"Amount paid plus outstanding amount does not match the invoice total.\");\n}\n\nconst existingRemarks =\n  invoice.remarks == null ? \"\" : String(invoice.remarks).trim();\n\nconst remarks = [\n  existingRemarks || null,\n  ...issues\n].filter(Boolean).join(\" | \") || null;\n\nconst previousStatus = invoice.verification_status;\n\nconst verificationStatus =\n  issues.length > 0 || previousStatus === \"needs_review\"\n    ? \"needs_review\"\n    : \"pending\";\n\nreturn {\n  json: {\n    invoice_number: invoice.invoice_number ?? null,\n    invoice_date: invoiceDate,\n    vendor_customer_name: invoice.vendor_customer_name ?? null,\n    gstin,\n    invoice_description: invoice.invoice_description ?? null,\n    invoice_type: category,\n    taxable_amount: taxable,\n    gst_amount: gst,\n    total_invoice_amount: total,\n    due_date: dueDate,\n    payment_status: paymentStatus,\n    amount_paid: amountPaid,\n    outstanding_amount: outstanding,\n    invoice_file_link: invoice.invoice_file_link ?? null,\n    remarks,\n    processing_status: \"processed\",\n    verification_status: verificationStatus\n  }\n};\n"
      },
